---
import Base from '@/layouts/Base.astro';
import '@/styles/hub.css';

const year = new Intl.DateTimeFormat('en', { timeZone: 'Asia/Seoul', year: 'numeric' }).format(new Date());
---
<Base title="Junior Board" description="오로라월드 주니어보드가 만드는 사내 서비스 모음." ogImage="/chuseok/og/pouch.jpg">
  <main class="jb-hub">
    <header class="jb-topbar">
      <span class="jb-brand">
        <span class="jb-brand-mark">JB</span>
        <span class="jb-brand-name">Junior Board</span>
      </span>
      <span class="jb-eyebrow">Aurora World</span>
    </header>

    <section style="display:flex;flex-direction:column;gap:12px;">
      <span class="jb-eyebrow">Services</span>
      <h1 class="jb-title">주니어보드가 만드는<br />작은 사내 서비스들</h1>
      <p class="jb-lead">함께 즐기는 이벤트와 매일의 작은 문장. 아래에서 골라 시작해 보세요.</p>
    </section>

    <ul class="jb-services">
      <li>
        <a class="jb-service" href="/chuseok">
          <span class="jb-service-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" fill="#f4c86a"/><circle cx="9" cy="10" r="1.6" fill="#e0ac47"/><circle cx="14.5" cy="14.5" r="1.2" fill="#e0ac47"/></svg>
          </span>
          <span class="jb-service-body">
            <span class="jb-service-tag">Now open</span>
            <span class="jb-service-name">나만의 한가위 캐릭터 테스트</span>
            <span class="jb-service-desc">8문항 상황형 테스트로 한가위 캐릭터를 확인하고 럭키드로우에 응모해요.</span>
          </span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </a>
      </li>
      <li>
        <a class="jb-service" href="/zen">
          <span class="jb-service-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h14v4a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5v-4Z"/><path d="M17 11h2a2 2 0 0 1 0 4h-2"/><path d="M7 3c.8 1.2.8 2.4 0 3.6"/><path d="M11 3c.8 1.2.8 2.4 0 3.6"/></svg>
          </span>
          <span class="jb-service-body">
            <span class="jb-service-tag" style="color:#8a7454;">Daily</span>
            <span class="jb-service-name">Zen Fortune</span>
            <span class="jb-service-desc">Roastery Zen 오늘의 문장과 페어링 음료 추천.</span>
          </span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </a>
      </li>
    </ul>

    <p class="jb-note" style="margin-top:auto;">© {year} Aurora World Junior Board</p>
  </main>
</Base>
