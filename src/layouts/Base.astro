---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /** 서비스별 파비콘. 기본은 주니어보드 마크. */
  favicon?: string;
  /** 공유 미리보기 이미지. 절대 URL 또는 /public 경로. 없으면 og:image 를 내지 않는다. */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description = 'Junior Board — 오로라월드 주니어보드가 만드는 사내 서비스.',
  bodyClass = '',
  favicon = '/jb-favicon.svg',
  ogImage,
  ogImageAlt,
} = Astro.props;
const faviconType = favicon.endsWith('.svg') ? 'image/svg+xml' : 'image/png';
// 공유 미리보기(Slack·카카오·iMessage). 절대 URL 이어야 하므로 요청 origin 기준으로 만든다.
// og:url 은 Slack 등이 미리보기 캐시 키로 쓰므로 쿼리까지 그대로 둔다 (?v=2 로 캐시 우회가 되게).
const pageUrl = new URL(Astro.url.pathname + Astro.url.search, Astro.url.origin).toString();
const ogImageUrl = ogImage ? new URL(ogImage, Astro.url.origin).toString() : null;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta http-equiv="Cache-Control" content="no-store" />
    <link rel="icon" type={faviconType} href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Junior Board" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <!-- Slack 테스트 결과: 1200×630 배너 + summary_large_image 조합이 가장 안정적으로 표시됨 -->
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
